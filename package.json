{
  "name": "autojobs",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev apps/web",
    "dev:admin": "next dev apps/admin --port 3001",
    "build": "next build apps/web && next build apps/admin",
    "start": "next start apps/web",
    "start:admin": "next start apps/admin --port 3001",
    "worker": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env apps/web/src/worker/index.ts",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "test": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env --test apps/web/tests/*.test.ts",
    "typecheck": "tsc --noEmit -p apps/web && tsc --noEmit -p apps/admin"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "nodemailer": "^10.0.11",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}

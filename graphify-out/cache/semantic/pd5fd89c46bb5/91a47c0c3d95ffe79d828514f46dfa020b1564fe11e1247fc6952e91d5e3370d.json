{"nodes": [{"id": "readme", "label": "AutoJobs README \u2014 Job Auto-Apply System (Phase 1 MVP)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_prd_job_auto_apply_system", "label": "PRD \u2014 Job Auto-Apply System", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_nextjs_web_app", "label": "Next.js Web App (UI + Server Actions)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_extension_api", "label": "Extension API (/api/extension/*, bearer token)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_postgresql_queue", "label": "PostgreSQL as Data Store and Persistent Queue (FOR UPDATE SKIP LOCKED)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lean stack with no Redis: claimNextForUser locks the next due item with FOR UPDATE SKIP LOCKED, so a portal account never has two attempts at once and the 120\u2013180 s gap holds even with several browsers paired."}, {"id": "readme_worker_process", "label": "Worker Process (campaign searches, crash recovery, retention)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JobStreet and LinkedIn are searched over plain HTTPS; Glints pages are loaded by the extension instead because Glints only answers a real browser the user has verified."}, {"id": "readme_autojobs_extension", "label": "AutoJobs Browser Extension (Chrome/Edge, Manifest V3)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applying runs in the user's own browser, with their own portal logins and internet connection, because portals' Cloudflare checks reject server-side automated browsers; the server therefore stores no portal passwords, sessions or cookies. For public distribution it goes to the Chrome Web Store with the localhost/127.0.0.1 host permissions removed."}, {"id": "readme_thin_executor_pattern", "label": "Thin-Executor Extension Pattern", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Portal patterns (adapters), answers (apply-plan), the gap, daily caps, retries and result handling live on the server, so fixing a portal means editing its adapter file with no extension update."}, {"id": "readme_autojobs_work_window", "label": "Dedicated AutoJobs Work Window", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each job is opened, filled and submitted in a dedicated window; when a portal shows a CAPTCHA or verification step the extension brings the window forward and waits for the user."}, {"id": "readme_no_bot_check_bypass", "label": "Never Bypass CAPTCHAs, 2FA or Bot Checks (human handoff policy)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "By design AutoJobs never solves or bypasses CAPTCHAs, 2FA or bot checks, never disguises automation, never stores portal passwords and never guesses answers to screening questions; the user completes verification steps."}, {"id": "readme_per_account_gap", "label": "Random 120\u2013180 s Gap per Portal Account", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applied per portal account so different portals run side by side; admin-configurable with a 120 s floor."}, {"id": "readme_daily_cap", "label": "Daily Cap of 25 Applications per Portal Account", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admin-configurable; overflow waits for the next day (Asia/Jakarta)."}, {"id": "readme_mandatory_preview", "label": "Mandatory Pre-Launch Preview", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The user unticks listings and confirms before launch; filtered-out listings are shown with their reason, criteria can be edited and re-run, and listings with an unknown experience level stay in, flagged 'level tidak diketahui'."}, {"id": "readme_dry_run_mode", "label": "Dry Run (Uji coba) Launch Option", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validation mode that fills every form but never clicks submit, so portal flows can be checked before live use."}, {"id": "readme_proof_capture", "label": "Application Proof Capture (confirmation text, HTML snapshot, optional screenshots)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Screenshots are only taken if the user grants 'access to all sites' in the extension popup, because Chrome's screenshot API needs it; proof files are deleted after the retention period."}, {"id": "readme_encrypted_file_store", "label": "Encrypted File Storage for CVs and Proofs (ENCRYPTION_KEY)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ENCRYPTION_KEY must be backed up: without it, stored CVs and proof files can't be read."}, {"id": "readme_multi_user_saas", "label": "Public Multi-User SaaS (consent sign-up, email verification, ADMIN_EMAILS admin role)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_smtp_email", "label": "SMTP Email Delivery via SMTP_URL", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any SMTP server works; without SMTP_URL, links are printed to the server log instead."}, {"id": "readme_jobstreet", "label": "JobStreet", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto-apply supported in Phase 1; searched by the worker over plain HTTPS; sign-in uses a one-time code sent by email."}, {"id": "readme_glints", "label": "Glints", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto-apply supported in Phase 1; its search pages are loaded by the extension because Glints only answers a real browser the user has verified."}, {"id": "readme_linkedin", "label": "LinkedIn", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Search-only in Phase 1 (applications recorded as manual); Easy Apply is deferred to Phase 2."}, {"id": "readme_extension_pairing", "label": "Extension Pairing Flow (pairing code)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A pairing code created under Koneksi Portal links the browser extension to the user's AutoJobs account; the user then signs in to the portals in that same browser and keeps it open while a campaign runs."}, {"id": "readme_first_real_run_validation", "label": "First Real Run per Portal (dry-run validation)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real apply forms sit behind each portal's login, so the apply patterns were written from public knowledge and checked only against the fake portal; small dry-run campaigns plus the Laporan timeline and HTML snapshot show where a flow stopped so the adapter can be adjusted before live use."}, {"id": "readme_extension_e2e_test", "label": "Extension End-to-End Test (Playwright + Microsoft Edge)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs in Edge because branded Chrome no longer loads unpacked extensions from the command line, and is skipped when Edge isn't installed; it applies against a fake JobStreet-style Quick Apply portal."}, {"id": "readme_deferred_scope", "label": "Not in This Build (PRD P1/P2, later phases)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme", "target": "readme_prd_job_auto_apply_system", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "docker_compose", "relation": "refere
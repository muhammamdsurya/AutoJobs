DATABASE_URL=postgres://autojobs:autojobs@localhost:5432/autojobs
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts CVs and proof files (AES-256-GCM). Losing it makes those unreadable.
ENCRYPTION_KEY=
# Public URL of the app: used in email links, the Secure cookie flag, and shown to users for pairing the extension.
APP_URL=http://localhost:3000
# Encrypted files (CVs, proof snapshots). Must be shared by the web and worker processes.
DATA_DIR=./data
# Comma-separated emails that get the admin role on sign-up / login.
ADMIN_EMAILS=
# Email (sign-up and password-reset codes). Leave MAIL_HOST empty to print emails to the server log instead.
# Gmail: turn on 2-Step Verification, create an App Password (myaccount.google.com/apppasswords) and use it as
# MAIL_PASSWORD (spaces are ignored). Alternatively one SMTP_URL=smtp://user:pass@host:587 replaces the MAIL_* lines.
# Gmail values: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls, MAIL_USERNAME=yourname@gmail.com.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=AutoJobs
# Campaign searches run in parallel per worker process.
WORKER_CONCURRENCY=3
# Sign in / sign up with Google (optional: the Google buttons only appear when both are set).
# Google Cloud Console → APIs & Services → OAuth consent screen (External), then Credentials → Create credentials →
# OAuth client ID → "Web application". Authorized redirect URI: <APP_URL>/api/auth/google/callback
# (for local dev: http://localhost:3000/api/auth/google/callback). Scopes used: openid, email, profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Admin console (apps/admin: `npm run dev:admin`, http://localhost:3001). Its public address, for the Secure cookie flag.
# Admins sign in there with their AutoJobs email and password (accounts listed in ADMIN_EMAILS). Token payments are
# confirmed by DANA notifications forwarded from an Android phone: set it up in the console (Pengaturan → Notifikasi DANA).
ADMIN_URL=http://localhost:3001
# Production (docker compose on the VPS, see docs/DEPLOY.md): the database password, set before the very first start
# (scripts/deploy.sh refuses to run without it), and the two domains Caddy gets HTTPS certificates for.
POSTGRES_PASSWORD=
DOMAIN=
ADMIN_DOMAIN=
